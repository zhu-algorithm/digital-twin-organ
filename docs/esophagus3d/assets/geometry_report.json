 "subject_selection": {
  "criteria_declared_before_measurement": {
   "S1": "largest connected component (26-connectivity) holds >= 95% of labelled voxels",
   "S2": "per-slice centre-of-mass centreline length >= 200 mm",
   "S3": "trachea label top no more than 5 mm below the oesophagus label top (cervical oesophagus inside the FOV)",
   "S4": "minimum surface gap from the distal 25 mm of the oesophagus label to the stomach label <= 10 mm",
   "S5": "aorta label spans the whole oesophageal cranio-caudal range",
   "S6": "maximum inscribed diameter <= 25 mm (exclude disease-driven dilatation)"
  },
  "criterion_corrections": [
   {
    "criterion": "S5",
    "problem": "as written, S5 is anatomically impossible - the aorta begins at the arch (~T4) and can never span the CERVICAL oesophagus, so all 22 measured subjects failed it.",
    "correction": "S5 restated as: the aortic arch apex must lie above the oesophageal mid-point (arch inside the FOV) AND the aorta must extend to within 5 mm of the oesophagus label's caudal end (hiatus reached).",
    "when": "after round 1, before any subject was selected"
   },
   {
    "criterion": "S3",
    "problem": "S3 is one-sided: it rejects a subject whose trachea stops below the oesophagus top but not one whose oesophagus label is truncated far BELOW the larynx. s0556 passed S3 with the trachea top 118.5 mm ABOVE the oesophagus top, which means its cervical oesophagus is unlabelled.",
    "correction": "NOT corrected - s0556 was not selected, so the outcome is unaffected. Recorded here rather than silently fixed.",
    "when": "noticed after round 2"
   }
  ],
  "round_2_criteria_added_post_hoc": {
   "trigger": "the round-1 winner s0692 has a 920.96 mL aorta (an ectatic/aneurysmal thoracoabdominal aorta) and an oesophageal tortuosity of 1.200 - the aneurysm displaces the oesophagus. The declared screen tested the oesophagus but never tested whether its NEIGHBOURS were normal. These two criteria were added AFTER seeing that result and are flagged as post hoc.",
   "S7": "aorta label volume between 90 and 350 mL (declared band for a non-ectatic thoracoabdominal aorta; not a single published figure)",
   "S8": "oesophageal centreline tortuosity (path / straight-line end-to-end) <= 1.12"
  },
  "tiebreaker": "largest labelled voxel count among passing subjects (most surface support for meshing)",
